generator client {
  provider = "prisma-client"
  output   = "../src/app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id         String                @id @default(cuid())
  name       String
  slug       String                @unique
  image      String
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  attributes AttributeDefinition[]
  products   Product[]
}

model Product {
  id             String                  @id @default(cuid())
  title          String
  slug           String                  @unique
  description    String?
  price          Decimal
  compareAtPrice Decimal?
  stock          Int                     @default(0)
  isFeatured     Boolean                 @default(false)
  isNew          Boolean                 @default(false)
  isBestSeller   Boolean                 @default(false)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  categoryId     String
  category       Category                @relation(fields: [categoryId], references: [id])
  attributes     ProductAttributeValue[]
  images         ProductImage[]
  options        ProductOption[]

  @@index([categoryId])
}

model ProductImage {
  id        String         @id @default(cuid())
  path      String
  alt       String?
  isPrimary Boolean        @default(false)
  sortOrder Int            @default(0)
  productId String
  optionId  String?
  option    ProductOption? @relation(fields: [optionId], references: [id], onDelete: Cascade)
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([optionId])
}

model ProductOption {
  id        String         @id @default(cuid())
  type      String
  name      String
  value     String?
  isDefault Boolean        @default(false)
  sortOrder Int            @default(0)
  productId String
  createdAt DateTime       @default(now())
  images    ProductImage[]
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([type])
}

model AttributeDefinition {
  id           String                  @id @default(cuid())
  name         String
  slug         String
  sortOrder    Int                     @default(0)
  isFilterable Boolean                 @default(false)
  isRequired   Boolean                 @default(false)
  categoryId   String
  category     Category                @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  options      AttributeOption[]
  values       ProductAttributeValue[]

  @@unique([categoryId, slug])
  @@index([categoryId])
}

model AttributeOption {
  id            String                  @id @default(cuid())
  value         String
  slug          String
  sortOrder     Int                     @default(0)
  attributeId   String
  attribute     AttributeDefinition     @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  productValues ProductAttributeValue[]

  @@unique([attributeId, slug])
  @@index([attributeId])
}

model ProductAttributeValue {
  id          String              @id @default(cuid())
  value       String?
  unit        String?
  productId   String
  attributeId String
  optionId    String?
  attribute   AttributeDefinition @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  option      AttributeOption?    @relation(fields: [optionId], references: [id])
  product     Product             @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, attributeId])
  @@index([productId])
  @@index([attributeId])
  @@index([optionId])
}
